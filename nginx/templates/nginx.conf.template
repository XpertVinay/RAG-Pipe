worker_processes auto;
worker_rlimit_nofile 65535;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # -------------------------------------------------------------------------
    # Upstream Load Balancing Observability Log Format
    # -------------------------------------------------------------------------
    # Enhanced format capturing detailed upstream routing and timing metrics:
    # - upstream_addr: IP:port of the chosen backend replica
    # - upstream_status: HTTP status returned by the upstream backend
    # - upstream_response_time: Upstream response latency in seconds
    # - upstream_connect_time: Latency to establish upstream TCP connection
    # - request_time: Total client transaction time
    log_format upstream_lb '$remote_addr - $remote_user [$time_local] "$request" '
                           '$status $body_bytes_sent "$http_referer" '
                           '"$http_user_agent" "$http_x_forwarded_for" '
                           'upstream_addr="$upstream_addr" '
                           'upstream_status="$upstream_status" '
                           'upstream_time="$upstream_response_time" '
                           'upstream_connect_time="$upstream_connect_time" '
                           'request_time="$request_time"';

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log upstream_lb;
    error_log  /var/log/nginx/error.log warn;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 75;
    keepalive_requests 20000;
    types_hash_max_size 2048;

    # Dynamic HTTP compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types application/json application/javascript text/css text/plain application/xml text/javascript;

    # HTTP Keepalive upgrade mapping
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # High-performance document & static file cache zone
    proxy_cache_path /tmp/nginx_cache levels=1:2 keys_zone=doc_cache:20m max_size=1g inactive=60m use_temp_path=off;

    # High-Performance DoS Protection & Burst Rate Limiting
    # Allocates 10MB memory zone to track client IPs (~160,000 distinct states)
    limit_req_zone $binary_remote_addr zone=dos_protect:10m rate=100r/s;
    limit_req_status 429;

    # -------------------------------------------------------------------------
    # Production Security & Load Balancer Verification Flags
    # -------------------------------------------------------------------------
    # Controlled via ENABLE_LB_DEBUG_HEADERS flag in environment / config:
    # - In development / testing: ENABLE_LB_DEBUG_HEADERS=true -> Exposes X-Served-By, etc.
    # - In production:           ENABLE_LB_DEBUG_HEADERS=false -> Headers suppressed!
    #
    # When $upstream_debug_addr evaluates to empty (""), Nginx add_header is suppressed.
    #
    # 1. Flag mapping (substituted by envsubst or defaults to "" in production):
    map "${ENABLE_LB_DEBUG_HEADERS}" $env_debug_upstream {
        "true"  $upstream_addr;
        "1"     $upstream_addr;
        "on"    $upstream_addr;
        default "";
    }

    # 2. Selective verification header (allows authorized testing via 'X-Debug-LB: 1'):
    map $http_x_debug_lb $upstream_debug_addr {
        "true"  $upstream_addr;
        "1"     $upstream_addr;
        default $env_debug_upstream;
    }

    map $upstream_debug_addr $upstream_debug_time {
        ""      "";
        default $upstream_response_time;
    }

    map $upstream_debug_addr $upstream_debug_status {
        ""      "";
        default $upstream_status;
    }

    # -------------------------------------------------------------------------
    # Reverse Proxy Upstream Pool for RAG Agent Backend Instances
    # -------------------------------------------------------------------------
    # Load balancing algorithms available:
    # - round-robin (default): Distributes incoming requests equally across all replicas
    # - least_conn: Routes to the backend instance with fewest active connections
    #               (ideal for long-running streaming LLM inference requests)
    # - ip_hash: Affinitizes client IP to a specific backend (not recommended for equal tests)
    upstream rag_backend {
        # Uncomment for least-connections load balancing:
        # least_conn;

        # Primary backend service. When scaled with 'docker compose up --scale rag-agent=N',
        # Docker's embedded DNS returns multiple A records, and Nginx balances between them.
        # max_fails=0 ensures Nginx never falsely marks the sole backend down during concurrency bursts
        server rag-agent:8000 max_fails=0;

        # Keepalive upstream connections pool for low-latency reuse under high concurrency
        keepalive 512;
    }

    server {
        listen ${PROXY_PORT} default_server backlog=4096;
        server_name _;

        # Support large multi-document uploads (PDF, DOCX, CSV, TXT up to 100MB)
        client_max_body_size 100M;
        client_body_buffer_size 128k;

        # Timeouts for heavy LLM queries & streaming inference
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        # Automatic upstream retry on transient connection resets
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 10s;

        # DoS Burst Protection: Allow bursts up to 200 requests nodelay; reject floods cleanly with HTTP 429
        limit_req zone=dos_protect burst=200 nodelay;

        # High-concurrency cached dashboard & root landing route
        location = / {
            proxy_pass http://rag_backend;
            proxy_http_version 1.1;

            add_header X-Served-By $upstream_debug_addr always;
            add_header X-Upstream-Response-Time $upstream_debug_time always;
            add_header X-Upstream-Status $upstream_debug_status always;
            add_header X-Cache-Status $upstream_cache_status always;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Cache the root HTML page with stampede lock
            proxy_cache doc_cache;
            proxy_cache_key "$scheme$request_method$host$request_uri";
            proxy_cache_valid 200 304 10m;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 5s;

            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 32 32k;
            proxy_busy_buffers_size 64k;
        }

        # High-concurrency document file preview and download route with caching & stampede lock
        location ~* ^/api/documents/[^/]+/file {
            proxy_pass http://rag_backend;
            proxy_http_version 1.1;

            add_header X-Served-By $upstream_debug_addr always;
            add_header X-Upstream-Response-Time $upstream_debug_time always;
            add_header X-Upstream-Status $upstream_debug_status always;
            add_header X-Cache-Status $upstream_cache_status always;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Cache document files to absorb repeated requests without backend stress
            proxy_cache doc_cache;
            proxy_cache_key "$scheme$request_method$host$request_uri";
            proxy_cache_valid 200 304 60m;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 5s;

            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 32 64k;
            proxy_busy_buffers_size 128k;
        }

        # Dedicated unbuffered location for Server-Sent Events (SSE) live streaming
        location ~* ^/api/(chat/stream|events|documents/stream) {
            proxy_pass http://rag_backend;
            proxy_http_version 1.1;

            add_header X-Served-By $upstream_debug_addr always;
            add_header X-Upstream-Response-Time $upstream_debug_time always;
            add_header X-Upstream-Status $upstream_debug_status always;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Critical: Disable buffering specifically for SSE live streaming updates
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding off;
            proxy_read_timeout 600s;
        }

        # Static assets cache
        location /static/ {
            proxy_pass http://rag_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;

            proxy_cache doc_cache;
            proxy_cache_valid 200 304 24h;
            expires 7d;
            add_header Cache-Control "public, max-age=604800, immutable";
            add_header X-Cache-Status $upstream_cache_status always;

            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 16 32k;
        }

        # Reverse Proxy for general API traffic & other HTML routes with response buffering
        location / {
            proxy_pass http://rag_backend;
            proxy_http_version 1.1;

            # Load Balancer Verification Response Headers
            # CRITICAL: Automatically suppressed in production when ENABLE_LB_DEBUG_HEADERS=false
            add_header X-Served-By $upstream_debug_addr always;
            add_header X-Upstream-Response-Time $upstream_debug_time always;
            add_header X-Upstream-Status $upstream_debug_status always;

            # WebSocket upgrade support & upstream keepalive
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Client identity propagation
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # High-concurrency response buffering (frees upstream workers immediately)
            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 32 32k;
            proxy_busy_buffers_size 64k;
        }

        # Load balancer & proxy health checks
        location ~ ^/(health|healthz|ping|api/health) {
            proxy_pass http://rag_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;

            # Load Balancer Verification Response Headers (suppressed in prod)
            add_header X-Served-By $upstream_debug_addr always;
            add_header X-Upstream-Response-Time $upstream_debug_time always;
            add_header X-Upstream-Status $upstream_debug_status always;

            access_log off;
        }

        # Load balancer diagnostic status probe
        location /lb-status {
            access_log /var/log/nginx/access.log upstream_lb;
            default_type application/json;
            return 200 '{"status":"ok","proxy_port":"${PROXY_PORT}","algorithm":"round_robin"}\n';
        }
    }
}
